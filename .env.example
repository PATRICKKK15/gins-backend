# Скопировать в .env и заполнить своими значениями

# Строка подключения к PostgreSQL
DATABASE_URL=postgres://gins_user:gins_password@localhost:5432/gins_db?sslmode=disable

# Секретный ключ для подписи JWT-токенов. Сгенерировать любую длинную
# случайную строку, например: openssl rand -base64 32
JWT_SECRET=change-me-to-a-real-secret

# Порт, на котором поднимается сервер
SERVER_PORT=8080
